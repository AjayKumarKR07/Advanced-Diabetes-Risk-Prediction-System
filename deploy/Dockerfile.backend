# =============================================================================
# DiabetesRisk AI — Production Backend Dockerfile
# =============================================================================
FROM python:3.11-slim as base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code and models
COPY backend/ ./backend/
COPY models/ ./models/
COPY results/ ./results/
COPY alembic.ini .
COPY alembic/ ./alembic/

# Create non-root user and persistent avatars storage
RUN useradd -m -u 1000 appuser && \
    mkdir -p uploads/avatars && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

# Health check using native /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with production ASGI server (gunicorn with uvicorn workers)
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers"]
